# ==============================================================================
# Van Vibes Customer Frontend — Environment Configuration Template (.env.example)
# ==============================================================================

# Cafe Branding & Metadata
NEXT_PUBLIC_APP_NAME="Vaan Vibes Cafe & Restro"
NEXT_PUBLIC_CAFE_HINDI_NAME="वन VIBES"
NEXT_PUBLIC_APP_TAGLINE="Cafe & Restro • Taste the Vibe"
NEXT_PUBLIC_APP_TITLE="Vaan Vibes Cafe & Restro — Digital QR Menu & Ordering"
NEXT_PUBLIC_APP_DESCRIPTION="A vibrant restro and cafe serving artisanal coffee, gourmet continental & indian cuisine, refreshing drinks, and memorable moments in a warm, aesthetic atmosphere."

# Cafe Contact & Location Details
NEXT_PUBLIC_CAFE_ADDRESS="Main Promenade, Serenita Arts Quarter, Surat, Gujarat - 395007"
NEXT_PUBLIC_CAFE_PHONE="+91 98765 43210"
NEXT_PUBLIC_CAFE_GSTIN="24AAAAA0000A1Z5"
NEXT_PUBLIC_CAFE_EMAIL="hello@vaanvibes.cafe"
NEXT_PUBLIC_CAFE_ORDERS_EMAIL="orders@vaanvibes.cafe"

# Cafe Operating Hours & Shift Timings (Morning, Afternoon Break & Evening)
NEXT_PUBLIC_CAFE_HOURS="10:00 AM - 03:30 PM, 05:30 PM - 11:30 PM"
NEXT_PUBLIC_CAFE_MORNING_HOURS="10:00 AM - 03:30 PM"
NEXT_PUBLIC_CAFE_BREAK_HOURS="03:30 PM - 05:30 PM"
NEXT_PUBLIC_CAFE_EVENING_HOURS="05:30 PM - 11:30 PM"

# Cuisines & Offerings (Comma-separated list)
NEXT_PUBLIC_CAFE_CUISINES="Artisanal Coffee, Contemporary Indian, Gourmet Continental, Beverages & Mocktails, Desserts & Bakery"

# Public Customer Frontend Base URL
# Leave empty ("") for automatic VPS IP / domain detection in the browser.
# Set only if using a fixed custom domain (e.g. "https://menu.vaanvibes.cafe")
NEXT_PUBLIC_APP_URL=""

# Backend REST API Integration (FastAPI Port: 9000)
# In browser, automatically matches the current server IP/domain on port 9000.
NEXT_PUBLIC_API_URL="http://localhost:9000/api/v1"
FASTAPI_BACKEND_URL="http://127.0.0.1:9000"

# Live WebSocket Stream URL (FastAPI Port: 9000)
# In browser, automatically matches ws:// (or wss:// on HTTPS) on the current server IP/domain.
NEXT_PUBLIC_WS_URL="ws://localhost:9000/api/v1/ws/orders"

# Server Port & Binding (Customer Frontend Port: 4000)
PORT=4000
HOSTNAME="0.0.0.0"
NODE_ENV="production"

# Logging Configuration
LOG_LEVEL="INFO"
LOG_CONSOLE=true
