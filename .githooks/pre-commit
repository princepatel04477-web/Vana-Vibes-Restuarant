#!/bin/sh
# ==============================================================================
# Cosmos Nexus Innovations — Git Pre-Commit Hook
# 1. Blocks accidental commits of secret/environment files (.env, .env.local, etc.)
# 2. Runs strict TypeScript check (pnpm typecheck)
# 3. Runs ESLint verification (pnpm lint)
# 4. Runs automated Vitest test suite (pnpm test)
# ==============================================================================

set -e

# ANSI Colors
BOLD="\033[1m"
GREEN="\033[0;32m"
RED="\033[0;31m"
CYAN="\033[0;36m"
YELLOW="\033[1;33m"
RESET="\033[0m"

echo "${CYAN}${BOLD}==> [Pre-Commit Hook] Running quality and security checks...${RESET}"

# 1. Security Check: Block isolated environment files
STAGED_ENV_FILES=$(git diff --cached --name-only | grep -E '(^|/)\.env(\..+)?$' | grep -v '\.env\.example$' || true)

if [ -n "$STAGED_ENV_FILES" ]; then
  echo ""
  echo "${RED}${BOLD}❌ [SECURITY GATE FAILED] Attempting to commit isolated environment file(s):${RESET}"
  echo "$STAGED_ENV_FILES"
  echo ""
  echo "${YELLOW}Environment files must never be committed to version control.${RESET}"
  echo "To unstage: git reset HEAD $STAGED_ENV_FILES"
  echo ""
  exit 1
fi

# 2. Strict TypeScript Verification
echo "  ${CYAN}• Checking TypeScript compilation (pnpm typecheck)...${RESET}"
if ! pnpm typecheck; then
  echo "${RED}❌ [TYPECHECK FAILED] TypeScript errors found. Fix them before committing.${RESET}"
  exit 1
fi

# 3. ESLint Verification
echo "  ${CYAN}• Running ESLint (pnpm lint)...${RESET}"
if ! pnpm lint; then
  echo "${RED}❌ [LINT FAILED] ESLint errors found. Fix them before committing.${RESET}"
  exit 1
fi

# 4. Continuous Testing Suite
echo "  ${CYAN}• Running unit test suite (pnpm test)...${RESET}"
if ! pnpm test; then
  echo "${RED}❌ [TEST SUITE FAILED] Automated unit tests failed.${RESET}"
  exit 1
fi

echo "${GREEN}${BOLD}✓ [Pre-Commit Hook] All quality and security checks passed!${RESET}"
exit 0
