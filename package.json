{
  "name": "vaan-vibes-restaurant-fullstack",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node start-fullstack.js",
    "dev:backend": "backend\\.venv\\Scripts\\python.exe -m uvicorn app.main:app --app-dir backend --host 127.0.0.1 --port 9000 --reload",
    "dev:frontend": "pnpm --filter van-vibes-frontend dev",
    "dev:management": "pnpm --filter vaan-vibes-management dev",
    "seed:backend": "backend\\.venv\\Scripts\\python.exe backend/manage.py seed",
    "typecheck:frontend": "pnpm --filter van-vibes-frontend typecheck",
    "typecheck:management": "pnpm --filter vaan-vibes-management typecheck",
    "typecheck": "pnpm typecheck:frontend && pnpm typecheck:management",
    "lint:frontend": "pnpm --filter van-vibes-frontend lint",
    "lint:management": "pnpm --filter vaan-vibes-management lint",
    "lint": "pnpm lint:frontend && pnpm lint:management",
    "test:backend": "backend\\.venv\\Scripts\\pytest.exe backend/tests",
    "test:frontend": "pnpm --filter van-vibes-frontend test",
    "test:management": "pnpm --filter vaan-vibes-management test",
    "test": "pnpm test:frontend && pnpm test:management"
  },
  "dependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/three": "^0.186.0",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "lucide-react": "^1.48.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.3.3",
    "vitest": "^5.0.0"
  }
}
